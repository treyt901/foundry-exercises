{
  "commands": {
    "Prompt Lab": {
      "Start": {
        "cmd": "bash lab.sh start",
        "preview": "Prompt Lab",
        "reloadPreview": true
      },
      "Restart (apply my changes)": {
        "cmd": "bash lab.sh restart",
        "preview": "Prompt Lab",
        "reloadPreview": true
      },
      "Stop": {
        "cmd": "bash lab.sh stop"
      }
    },
    "Test my endpoint connection": "bash lab.sh test"
  },
  "preview": {
    "Prompt Lab": "https://{{domain5000}}/"
  }
}
