# =============================================================================
# Azure OpenAI configuration for the Foundry Exercises Prompt Lab
# =============================================================================
# STUDENT INSTRUCTIONS
#   1. Fill in the values below from your Azure OpenAI resource.
#   2. Save the file (Ctrl/Cmd + S).
#   3. Press the "Test my connection" button in the guide to verify it works.
#
# You can find these values in the Azure AI Foundry portal (or Azure portal)
# under your Azure OpenAI resource:
#   - Endpoint & Keys:  "Keys and Endpoint" page
#   - Deployment name:  "Deployments" / "Model deployments" page
#
# NOTE FOR INSTRUCTORS: this file ships with the assignment so students can
# fill it in directly. Never commit it with real values in it.
# -----------------------------------------------------------------------------

# The base URL of your Azure OpenAI resource.
# Example: https://my-openai-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# One of the two keys from the "Keys and Endpoint" page.
AZURE_OPENAI_API_KEY=

# The NAME YOU GAVE your model deployment (NOT the model name).
# Example: gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT=

# The REST API version. A recent stable version is fine for this lab.
AZURE_OPENAI_API_VERSION=2024-10-21
